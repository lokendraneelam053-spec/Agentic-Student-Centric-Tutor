rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all (Phase 4, Rule 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test rule
    match /test/connection {
      allow read: if true;
    }

    // User-scoped data: users can only read and write their own documents and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
